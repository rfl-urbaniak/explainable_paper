\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Desiderata satisfied (\text  {$\mathsurround \z@ \mathchar "458$}) and violated (\texttimes ) by plain SHAP, Causal SHAP, and PCI (alternative $\sim P(A)$, prior-noise sufficiency) on the signal with mediation example ($X\!\to \!M\!\to \!Y$), instance $X=M=Y=1$. PCI values are signed $\bar  c = \mathbb  {E}[|Y^n-B^\star |] - \mathbb  {E}[|Y^s-B^\star |]$; $\mathbf  {S}$ = both input features of $B$, $\Gamma _s$/$\Gamma _w$ uniform. \textbf  {W=3rd}: the third variable (neither $A$ nor $B$) is in $\mathbf  {W}$ and sampled as an active witness when not in $C$. $^\dagger $~0.186 weights three suspect-containing $(C,T)$ configurations at $1/4$ each (the rejection-sampling normalizer $Z=2/3$ also counts a fourth valid pair $(\{M\},\emptyset )$ that does not contain $X$): one pins $M$ as witness (contribution~0, necessity and sufficiency coincide) and two let $M$ propagate freely (contributions~0.320 and 0.425). $^\ddagger $~The two values use different witness sets ($\mathbf  {W}{=}\{M\}$ for DXY, $\mathbf  {W}{=}\{X\}$ for DMY), so the comparison is illustrative rather than a single-game ranking.}}{26}{table.caption.23}\protected@file@percent }
\newlabel{tab:signal_desid}{{9}{26}{Desiderata satisfied (\checkmark ) and violated (\texttimes ) by plain SHAP, Causal SHAP, and PCI (alternative $\sim P(A)$, prior-noise sufficiency) on the signal with mediation example ($X\!\to \!M\!\to \!Y$), instance $X=M=Y=1$. PCI values are signed $\bar c = \mathbb {E}[|Y^n-B^\star |] - \mathbb {E}[|Y^s-B^\star |]$; $\mathbf {S}$ = both input features of $B$, $\Gamma _s$/$\Gamma _w$ uniform. \textbf {W=3rd}: the third variable (neither $A$ nor $B$) is in $\mathbf {W}$ and sampled as an active witness when not in $C$. $^\dagger $~0.186 weights three suspect-containing $(C,T)$ configurations at $1/4$ each (the rejection-sampling normalizer $Z=2/3$ also counts a fourth valid pair $(\{M\},\emptyset )$ that does not contain $X$): one pins $M$ as witness (contribution~0, necessity and sufficiency coincide) and two let $M$ propagate freely (contributions~0.320 and 0.425). $^\ddagger $~The two values use different witness sets ($\mathbf {W}{=}\{M\}$ for DXY, $\mathbf {W}{=}\{X\}$ for DMY), so the comparison is illustrative rather than a single-game ranking}{table.caption.23}{}}
\newlabel{tab:signal_desid@cref}{{[table][9][]9}{[1][26][]26}}
